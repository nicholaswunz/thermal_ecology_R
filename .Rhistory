dplyr::filter(torpor == "Yes", type %in% c("Experiment", "Experiment/Field", "Field"), method != "")
method_plot <- torpor_filter %>%
group_by(method) %>%
summarise(papers = n_distinct(ID)) %>%
ggplot() +
