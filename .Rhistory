torpor_raw <- read.csv("/Users/nicholaswu/Library/CloudStorage/OneDrive-MurdochUniversity/Manuscripts/Bat torpor review/articles_analysis.csv")
glimpse(torpor_raw)
torpor_clean <- torpor_raw %>%
dplyr::mutate(bat      = as.factor(bat),
torpor   = as.factor(torpor),
type     = as.factor(type),
method   = as.factor(method),
stressor = as.factor(stressor)
)
levels(torpor_clean$type)
# Number of records looking at torpor
torpor_clean %>%
summarise(
yes = n_distinct(ID[torpor == "Yes"]),
no  = n_distinct(ID[torpor == "No"]),
yes_per = yes / n_distinct(ID) * 100,
no_per = no / n_distinct(ID) * 100
)
# By research type
type_plot <- torpor_clean %>%
dplyr::filter(torpor == "Yes" & type != "") %>%
group_by(type) %>%
summarise(papers = n_distinct(ID)) %>%
ggplot() +
geom_bar(aes(x = reorder(type, -papers), y = papers), stat = "identity") +
labs(x = NULL) +
theme_bw()
# Number of records looking at torpor
torpor_clean %>%
summarise(
yes = n_distinct(ID[torpor == "Yes"]),
no  = n_distinct(ID[torpor == "No"]),
yes_per = yes / n_distinct(ID) * 100,
no_per = no / n_distinct(ID) * 100
)
